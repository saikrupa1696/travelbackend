# Spring Datasource Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/travelmate_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=your_database_username
SPRING_DATASOURCE_PASSWORD=your_database_password

# JWT Security
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Provider Configuration (RULE_BASED, GEMINI, or OPENAI)
AI_PROVIDER=RULE_BASED
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_BASE_URL=

# Places Integration
PLACES_PROVIDER=NOMINATIM
PLACES_USER_AGENT=TravelMateAI/1.0
